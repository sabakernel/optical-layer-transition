{
  "imports": {
    "vite": "npm:vite@^6",
    "react": "npm:react@^18",
    "react-dom": "npm:react-dom@^18",
    "react/jsx-runtime": "npm:react@^18/jsx-runtime",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
    "@sabakernel/optical-layer-transitionn": "../mod.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "include": ["src/", "vite.config.ts"],
    "exclude": ["dist/", "node_modules/"]
  },
  "fmt": {
    "include": ["src/", "vite.config.ts"],
    "exclude": ["dist/", "node_modules/"],
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "preview": "deno run -A --node-modules-dir=auto npm:vite preview",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
