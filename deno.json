{
  "name": "@sabakernel/gl-noise-transition",
  "version": "1.0.0",
  "exports": "./mod.ts",
  "workspace": ["./demo"],
  "publish": {
    "include": ["src/", "deno.json", "mod.ts", "README.md"],
    "exclude": ["node_modules/"]
  },
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "fmt": {
    "include": ["mod.ts", "src/"],
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check mod.ts src/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
